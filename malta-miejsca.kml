<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
<name>Malta z Mamą: 2–6.11.2026</name>
<description>Miejsca z poprawionego planu. Warstwy według dni.</description>
<Style id="s_baza"><IconStyle><color>ff754c0f</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s_pon"><IconStyle><color>ffa04f6b</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s_wt"><IconStyle><color>ff2d37c8</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s_sr"><IconStyle><color>ff4e7d2f</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s_czw"><IconStyle><color>ff007ad9</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s_pt"><IconStyle><color>ff665f55</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s_alt"><IconStyle><color>ff3b6d8a</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Folder><name>Baza: hotel</name>
<Placemark><name>The Howard Hotel</name><description>Nasz hotel. Triq Ġużè Howard, Sliema. Śniadanie zwykle 7:30–10:30. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.915217,14.499725</description><styleUrl>#s_baza</styleUrl><Point><coordinates>14.499725,35.915217,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Pon 2.11: przylot</name>
<Placemark><name>Lotnisko Malta (MLA)</name><description>Przylot 15:45. Bolt odbiera z parkingu: z hali przylotów poziom -1 i tunel. Ok. 12–20 € do Sliemy. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.84741,14.492287</description><styleUrl>#s_pon</styleUrl><Point><coordinates>14.492287,35.847410,0</coordinates></Point></Placemark>
<Placemark><name>Promenada przy Exiles</name><description>Ławki i widok na morze, 2–3 min od hotelu. Kawa w Exiles Beach Club. Zachód słońca ok. 17:05. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.91843,14.498724</description><styleUrl>#s_pon</styleUrl><Point><coordinates>14.498724,35.918430,0</coordinates></Point></Placemark>
<Placemark><name>Fresco&#x27;s (kolacja)</name><description>Tower Road, ok. 250 m od hotelu. Ryby i owoce morza, ryba dnia. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.914802,14.496807</description><styleUrl>#s_pon</styleUrl><Point><coordinates>14.496807,35.914802,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Wt 3.11: Valletta</name>
<Placemark><name>City Gate</name><description>Wejście do Valletty; tu wysiadamy z Bolta. Dalej płasko Republic Street. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.895914,14.509422</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.509422,35.895914,0</coordinates></Point></Placemark>
<Placemark><name>Konkatedra św. Jana</name><description>Pon–sob 9:00–16:45, ostatnie wejście 16:00. Dorośli 15 €, seniorzy i studenci 12 €. Audioprzewodnik po polsku. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.897696,14.512629</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.512629,35.897696,0</coordinates></Point></Placemark>
<Placemark><name>Merchant Street (opcjonalnie)</name><description>Ulica z drewnianymi balkonami przy Konkatedrze. Krótki spacer w stronę Barrakki. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.897444,14.513235</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.513235,35.897444,0</coordinates></Point></Placemark>
<Placemark><name>MUŻA: muzeum sztuki i kawa na dziedzińcu (opcjonalnie)</name><description>Auberge d&#x27;Italie, Merchants St. Dorośli 10 €, seniorzy 60+ i studenci 7,50 €. W XI wg strony muzeum 10:00–18:00 (inne źródło: 9:00–17:00). MUŻA Restaurant na dziedzińcu: wt 10:00–16:00. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.896293,14.511262</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.511262,35.896293,0</coordinates></Point></Placemark>
<Placemark><name>Ogrody Górnej Barrakki</name><description>Ławki i widok na Wielki Port. Strzał z armaty o 12:00 i 16:00 (pon–sob), z tarasu za darmo. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.894955,14.512009</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.512009,35.894955,0</coordinates></Point></Placemark>
<Placemark><name>Palazzo Preca (obiad)</name><description>Strait Street 54. Wt 12:00–15:45. Ryby i kuchnia maltańska. Rezerwacja +356 2122 6777. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.898778,14.512277</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.512277,35.898778,0</coordinates></Point></Placemark>
<Placemark><name>Casa Rocca Piccola (opcjonalnie)</name><description>74 Republic St. Pon–sob, zwiedzanie z przewodnikiem co godzinę 10:00–16:00. Dorośli 12 €, studenci 8 €. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.899884,14.515346</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.515346,35.899884,0</coordinates></Point></Placemark>
<Placemark><name>Teatr Manoel (opcjonalnie)</name><description>Old Theatre St. Zwiedzanie pon–pt 11:00 i 15:00, sob 10:30/11:30/12:30, 10 €. Próby mogą odwołać zwiedzanie. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.899765,14.512575</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.512575,35.899765,0</coordinates></Point></Placemark>
<Placemark><name>Victoria Gate</name><description>Brama od strony Wielkiego Portu; najwygodniej zobaczyć z taksówki lub Bolta. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.895982,14.513645</description><styleUrl>#s_wt</styleUrl><Point><coordinates>14.513645,35.895982,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Śr 4.11: wycieczka z przewodnikiem „Malta North”</name>
<Placemark><name>Golden Bay i Għajn Tuffieħa z góry</name><description>Punkt widokowy przy wieży Għajn Tuffieħa, widać obie zatoki. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.930865,14.343339</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.343339,35.930865,0</coordinates></Point></Placemark>
<Placemark><name>Mġarr: kościół</name><description>Kościół parafialny w Mġarrze. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.919513,14.366118</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.366118,35.919513,0</coordinates></Point></Placemark>
<Placemark><name>Manikata</name><description>Mała wioska po drodze. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.940721,14.353765</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.353765,35.940721,0</coordinates></Point></Placemark>
<Placemark><name>Zatoka Ġnejna</name><description>Zatoka z czerwonawym piaskiem, otoczona klifami. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.922134,14.341877</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.341877,35.922134,0</coordinates></Point></Placemark>
<Placemark><name>Anchor Bay i Popeye Village (punkt widokowy)</name><description>Widok z góry na dawny plan filmowy w zatoce Anchor Bay. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.959903,14.341065</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.341065,35.959903,0</coordinates></Point></Placemark>
<Placemark><name>Czerwona Wieża (St Agatha&#x27;s Tower)</name><description>Wieża z XVII w. na grzbiecie Marfa, widok na Gozo i Comino. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.974675,14.342853</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.342853,35.974675,0</coordinates></Point></Placemark>
<Placemark><name>Rdum il-Qammieħ (do zapytania przewodniczki)</name><description>Punkt widokowy z ławkami na krawędzi klifów Marfa Ridge, niedaleko Czerwonej Wieży. Podjazd autem prawie pod sam punkt. Przy klifie nie ma barierek: trzymać się z dala od krawędzi. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.972228,14.334305</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.334305,35.972228,0</coordinates></Point></Placemark>
<Placemark><name>Biała Wieża (Torri l-Abjad)</name><description>Wieża na półwyspie Aħrax. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.995485,14.364495</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.364495,35.995485,0</coordinates></Point></Placemark>
<Placemark><name>Figura Madonny na klifach Aħrax</name><description>Figura Madonny i kaplica nad klifami. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.988374,14.375494</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.375494,35.988374,0</coordinates></Point></Placemark>
<Placemark><name>Cypel Aħrax: widok na Gozo, Comino i Blue Lagoon</name><description>Północny cypel Malty. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.99838,14.367515</description><styleUrl>#s_sr</styleUrl><Point><coordinates>14.367515,35.998380,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Czw 5.11: dzień na plaży (wariant A lub B)</name>
<Placemark><name>Wariant A: Mellieħa Bay (Għadira)</name><description>Największa piaszczysta plaża Malty, bardzo płytko i łagodnie. Bolt ok. 30–40 min, ok. 22–28 €. Po 31.10 bez ratowników i leżaków. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.97096,14.34979</description><styleUrl>#s_czw</styleUrl><Point><coordinates>14.349790,35.970960,0</coordinates></Point></Placemark>
<Placemark><name>Blu Beach Club (Mellieħa Bay)</name><description>Restauracja przy wodzie, czynna cały rok. Tel. +356 7938 7538, rezerwacje: blubeach.com.mt/reservations. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.966076,14.35593</description><styleUrl>#s_czw</styleUrl><Point><coordinates>14.355930,35.966076,0</coordinates></Point></Placemark>
<Placemark><name>Munchies Mellieħa Bay</name><description>Restauracja nad plażą z widokiem na morze. Tel. +356 2157 6416, res@munchiesmalta.com. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.972246,14.349796</description><styleUrl>#s_czw</styleUrl><Point><coordinates>14.349796,35.972246,0</coordinates></Point></Placemark>
<Placemark><name>Wariant B: St George&#x27;s Bay (St Julian&#x27;s)</name><description>Mała piaszczysta plaża, płytko. Bolt ok. 10 min, ok. 6–9 €. Publiczne toalety, dużo kawiarni wokół. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=St%20George%27s%20Bay%20Beach%20St%20Julian%27s</description><styleUrl>#s_czw</styleUrl><Point><coordinates>14.488350,35.926050,0</coordinates></Point></Placemark>
<Placemark><name>Barracuda (ostatnia kolacja)</name><description>Po plaży, wieczorem. Balluta Bay, ok. 450 m od hotelu. Ryby i owoce morza z widokiem na zatokę. Rezerwacja. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.915331,14.495074</description><styleUrl>#s_czw</styleUrl><Point><coordinates>14.495074,35.915331,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Pt 6.11: powrót</name>
<Placemark><name>Lotnisko Malta (MLA): wylot 9:25</name><description>Taksówka spod hotelu o 7:00, zamówiona dzień wcześniej. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.84741,14.492287</description><styleUrl>#s_pt</styleUrl><Point><coordinates>14.492287,35.847410,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Warianty zapasowe i inne restauracje</name>
<Placemark><name>Mdina (wariant zapasowy)</name><description>Rano Boltem pod bramę, potem Fontanella. W środku płasko, ale gładkie kamienne płyty, po deszczu śliskie. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.884811,14.403517</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.403517,35.884811,0</coordinates></Point></Placemark>
<Placemark><name>Fontanella Tea Garden</name><description>Taras na murach, codziennie 10:00–23:30, bez rezerwacji. Słynie z ciast. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.887164,14.403695</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.403695,35.887164,0</coordinates></Point></Placemark>
<Placemark><name>Katedra św. Pawła i Muzeum Katedralne (Mdina)</name><description>Wspólny bilet: katedra i muzeum. Dorośli 15 €, seniorzy 60+ i studenci 10 €. Pon–sob 9:30–16:30, bilety do 16:15. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.886393,14.404119</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.404119,35.886393,0</coordinates></Point></Placemark>
<Placemark><name>San Anton Gardens, Attard (po drodze do Mdiny)</name><description>Ogrody przy pałacu prezydenta, wstęp wolny. Codziennie co najmniej 7:00–17:00. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.896107,14.448178</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.448178,35.896107,0</coordinates></Point></Placemark>
<Placemark><name>Rotunda w Moście (Mosta Dome)</name><description>Pon–pt 9:30–18:00, sob 9:30–16:30, nd 12:00–17:00 (ostatnie wejście 30 min wcześniej). Bilet 5 € lub 8 €. Strój jak do kościoła. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.910083,14.42581</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.425810,35.910083,0</coordinates></Point></Placemark>
<Placemark><name>Sliema Ferries: Harbour Cruise (wariant zapasowy)</name><description>Rejs po porcie 90 min, zimą ok. 10:30, 12:30 i 14:45, ok. 16–20 €, bez rezerwacji. Dobre na dzień zbyt chłodny na plażę. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.908833,14.504283</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.504283,35.908833,0</coordinates></Point></Placemark>
<Placemark><name>Malta Experience (gdy pada)</name><description>45-minutowy pokaz o historii Malty. 20 €. Godziny i język polski do potwierdzenia. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.899761,14.518767</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.518767,35.899761,0</coordinates></Point></Placemark>
<Placemark><name>Forty Fishes Gżira</name><description>Ix-Xatt 225, Gżira. Ryby z grilla. Punkt przybliżony (ulica), link szuka po nazwie. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=Forty%20Fishes%20Gzira%20225%20Triq%20ix-Xatt</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.497714,35.906360,0</coordinates></Point></Placemark>
<Placemark><name>Tartarun, Marsaxlokk (zamknięte pon. i czw.)</name><description>Restauracja rybna nad nabrzeżem. Google Maps: https://www.google.com/maps/search/?api=1&amp;query=35.841489,14.545344</description><styleUrl>#s_alt</styleUrl><Point><coordinates>14.545344,35.841489,0</coordinates></Point></Placemark>
</Folder>
</Document>
</kml>
